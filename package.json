{
  "name": "typewriter-effect",
  "version": "3.3.0",
  "main": "dist/react.js",
  "types": "index.d.ts",
  "bin": {
    "typewriter-effect": "dist/cli.js"
  },
  "keywords": [
    "typewriter",
    "typewriter effect",
    "es6",
    "react",
    "react typewriter",
    "react typewriter effect"
  ],
  "files": [
    "dist",
    "index.d.ts",
    "LICENSE",
    "readme.md",
    "CHANGELOG.md"
  ],
  "repository": "git@github.com:tameemsafi/typewriterjs.git",
  "author": "Tameem Safi <tameem@safi.me.uk>",
  "license": "MIT",
  "scripts": {
    "build:prod": "webpack --config ./webpack/production.config.mjs",
    "build:dev": "webpack --config ./webpack/development.config.mjs",
    "test": "jest --env=jsdom",
    "demo:gif": "npm run build:prod && node dist/cli.js --demo --gif preview.gif"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "puppeteer": ">=22.0.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "browserslist": [
    "baseline widely available with downstream"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@sinonjs/fake-timers": "^15.4.0",
    "@testing-library/react": "^16.3.3",
    "babel-loader": "^10.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1"
  },
  "overrides": {
    "babel-preset-current-node-syntax": {
      "@babel/core": "$@babel/core"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  }
}
